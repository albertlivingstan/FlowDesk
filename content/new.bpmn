<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="FlowDeskDefinitions" targetNamespace="https://flowdesk.local/email-to-ticket">
  <bpmn:process id="EmailToTicket" name="Email to Ticket" isExecutable="true">
    <bpmn:documentation>Importable BPMN 2.0 orchestration model. Bind each task in Studio Web before publishing; see docs/UIPATH_SETUP.md. Triage maps is_ticket to isTicket and exports confidence, category, priority, summary, description. The API suspends low-confidence requests with status needs_review. No connector credentials are embedded.</bpmn:documentation>
    <bpmn:startEvent id="manualTrigger1" name="Email to Ticket">
      <bpmn:outgoing>startToTriage</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="aiTriage" name="AI Triage">
      <bpmn:documentation>Classify the email with the exact prompt in automation/triage.py. Validate strict output. Set isTicket = is_ticket. Initialize ticketKey and ticketUrl to empty strings. Fall back to keyword rules on provider failure.</bpmn:documentation>
      <bpmn:incoming>startToTriage</bpmn:incoming>
      <bpmn:outgoing>triageToDecision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="triageDecision" name="Support request?" gatewayDirection="Diverging">
      <bpmn:incoming>triageToDecision</bpmn:incoming>
      <bpmn:outgoing>ignoreEmail</bpmn:outgoing>
      <bpmn:outgoing>automaticTicket</bpmn:outgoing>
      <bpmn:outgoing>reviewEmail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ignoredEnd" name="Ignored">
      <bpmn:documentation>Output isTicket=false, ticketKey="", ticketUrl="", status="ignored".</bpmn:documentation>
      <bpmn:incoming>ignoreEmail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="humanReview" name="Human Review">
      <bpmn:documentation>Set status="needs_review" while waiting. Show original mail and triage. Complete only after explicit approval and correction of structured fields. Reject by cancelling the process; do not complete approval. Resume the approved request through the common Jira path.</bpmn:documentation>
      <bpmn:incoming>reviewEmail</bpmn:incoming>
      <bpmn:outgoing>reviewToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approvedMerge" name="Ready to create" gatewayDirection="Converging">
      <bpmn:incoming>automaticTicket</bpmn:incoming>
      <bpmn:incoming>reviewToMerge</bpmn:incoming>
      <bpmn:outgoing>mergeToJira</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="createJiraTicket" name="Create Jira Ticket">
      <bpmn:documentation>Search KAN summaries created in the last 24h; exclude KAN-1, KAN-2, KAN-3 and compare normalized summaries exactly. Comment on a safe duplicate, otherwise create a Task. Map category label (Feature-Request for Feature Request), priority and ADF description including reporter. Return ticketKey and ticketUrl. Throw on unrecoverable Jira errors.</bpmn:documentation>
      <bpmn:incoming>mergeToJira</bpmn:incoming>
      <bpmn:outgoing>jiraToConfirmation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="jiraErrorBoundary" name="Jira error" attachedToRef="createJiraTicket" cancelActivity="true">
      <bpmn:outgoing>jiraErrorToAdmin</bpmn:outgoing>
      <bpmn:errorEventDefinition id="catchJiraError" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="sendConfirmationEmail" name="Send Confirmation Email">
      <bpmn:documentation>Reply to senderEmail with ticketKey and priority. Set status="created" once Jira is saved. If email fails, notify admin and retain the created ticket key rather than recreating the issue.</bpmn:documentation>
      <bpmn:incoming>jiraToConfirmation</bpmn:incoming>
      <bpmn:outgoing>confirmationToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="createdEnd" name="Ticket created">
      <bpmn:documentation>Output isTicket=true, ticketKey, ticketUrl, status="created".</bpmn:documentation>
      <bpmn:incoming>confirmationToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="notifyAdmin" name="Notify Admin">
      <bpmn:documentation>Set status="failed". Log a redacted error and notify configured admin through an email connector. Do not disclose secrets or the original email body.</bpmn:documentation>
      <bpmn:incoming>jiraErrorToAdmin</bpmn:incoming>
      <bpmn:outgoing>adminToFailed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="failedEnd" name="Failed">
      <bpmn:documentation>Output isTicket=true, ticketKey="", ticketUrl="", status="failed". Check for ambiguous Jira writes before retrying.</bpmn:documentation>
      <bpmn:incoming>adminToFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="startToTriage" sourceRef="manualTrigger1" targetRef="aiTriage" />
    <bpmn:sequenceFlow id="triageToDecision" sourceRef="aiTriage" targetRef="triageDecision" />
    <bpmn:sequenceFlow id="ignoreEmail" name="isTicket = false" sourceRef="triageDecision" targetRef="ignoredEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript"><![CDATA[isTicket === false]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="automaticTicket" name="confidence &gt;= 0.7" sourceRef="triageDecision" targetRef="approvedMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript"><![CDATA[isTicket === true && confidence >= 0.7]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="reviewEmail" name="confidence &lt; 0.7" sourceRef="triageDecision" targetRef="humanReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="JavaScript"><![CDATA[isTicket === true && confidence < 0.7]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="reviewToMerge" name="Approved and corrected" sourceRef="humanReview" targetRef="approvedMerge" />
    <bpmn:sequenceFlow id="mergeToJira" sourceRef="approvedMerge" targetRef="createJiraTicket" />
    <bpmn:sequenceFlow id="jiraToConfirmation" sourceRef="createJiraTicket" targetRef="sendConfirmationEmail" />
    <bpmn:sequenceFlow id="confirmationToEnd" sourceRef="sendConfirmationEmail" targetRef="createdEnd" />
    <bpmn:sequenceFlow id="jiraErrorToAdmin" sourceRef="jiraErrorBoundary" targetRef="notifyAdmin" />
    <bpmn:sequenceFlow id="adminToFailed" sourceRef="notifyAdmin" targetRef="failedEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="EmailToTicketDiagram">
    <bpmndi:BPMNPlane id="EmailToTicketPlane" bpmnElement="EmailToTicket">
      <bpmndi:BPMNShape id="manualTrigger1_di" bpmnElement="manualTrigger1"><dc:Bounds x="60" y="220" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="35" y="262" width="90" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="aiTriage_di" bpmnElement="aiTriage"><dc:Bounds x="160" y="198" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="triageDecision_di" bpmnElement="triageDecision" isMarkerVisible="true"><dc:Bounds x="350" y="213" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="328" y="178" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ignoredEnd_di" bpmnElement="ignoredEnd"><dc:Bounds x="510" y="50" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="493" y="93" width="70" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="humanReview_di" bpmnElement="humanReview"><dc:Bounds x="450" y="360" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approvedMerge_di" bpmnElement="approvedMerge" isMarkerVisible="true"><dc:Bounds x="650" y="213" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="630" y="178" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createJiraTicket_di" bpmnElement="createJiraTicket"><dc:Bounds x="760" y="198" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="jiraErrorBoundary_di" bpmnElement="jiraErrorBoundary"><dc:Bounds x="822" y="260" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="860" y="295" width="65" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendConfirmationEmail_di" bpmnElement="sendConfirmationEmail"><dc:Bounds x="960" y="198" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createdEnd_di" bpmnElement="createdEnd"><dc:Bounds x="1180" y="220" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1151" y="262" width="95" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyAdmin_di" bpmnElement="notifyAdmin"><dc:Bounds x="950" y="440" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="failedEnd_di" bpmnElement="failedEnd"><dc:Bounds x="1180" y="462" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1168" y="505" width="60" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="startToTriage_di" bpmnElement="startToTriage"><di:waypoint x="96" y="238" /><di:waypoint x="160" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="triageToDecision_di" bpmnElement="triageToDecision"><di:waypoint x="290" y="238" /><di:waypoint x="350" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ignoreEmail_di" bpmnElement="ignoreEmail"><di:waypoint x="375" y="213" /><di:waypoint x="375" y="68" /><di:waypoint x="510" y="68" /><bpmndi:BPMNLabel><dc:Bounds x="395" y="43" width="100" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="automaticTicket_di" bpmnElement="automaticTicket"><di:waypoint x="400" y="238" /><di:waypoint x="650" y="238" /><bpmndi:BPMNLabel><dc:Bounds x="457" y="212" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reviewEmail_di" bpmnElement="reviewEmail"><di:waypoint x="375" y="263" /><di:waypoint x="375" y="400" /><di:waypoint x="450" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="385" y="326" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reviewToMerge_di" bpmnElement="reviewToMerge"><di:waypoint x="590" y="400" /><di:waypoint x="675" y="400" /><di:waypoint x="675" y="263" /><bpmndi:BPMNLabel><dc:Bounds x="597" y="411" width="145" height="35" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mergeToJira_di" bpmnElement="mergeToJira"><di:waypoint x="700" y="238" /><di:waypoint x="760" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jiraToConfirmation_di" bpmnElement="jiraToConfirmation"><di:waypoint x="900" y="238" /><di:waypoint x="960" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="confirmationToEnd_di" bpmnElement="confirmationToEnd"><di:waypoint x="1110" y="238" /><di:waypoint x="1180" y="238" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jiraErrorToAdmin_di" bpmnElement="jiraErrorToAdmin"><di:waypoint x="840" y="296" /><di:waypoint x="840" y="480" /><di:waypoint x="950" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="adminToFailed_di" bpmnElement="adminToFailed"><di:waypoint x="1090" y="480" /><di:waypoint x="1180" y="480" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
